# Exemple de configuration BUND. Copie-le vers ~/.bund/bund.env.conf
# ou utilise /conf. Les clés API ne vont jamais ici.
BUND_PROVIDER=OPENAI
BUND_API_BASE_URL=https://api.openai.com/v1
BUND_MODEL=gpt-4.1-mini
BUND_API_KEY_ENV=OPENAI_API_KEY
BUND_MODE=cloud
BUND_AGENT=bund
BUND_MAX_STEPS=100
BUND_MAX_RETRIES=2
BUND_TIMEOUT_SECONDS=120
BUND_AUTO_EDIT=false
BUND_AUTO_TEST=true
BUND_AUTO_COMMIT=false
BUND_AUTO_PUSH=false
BUND_GITHUB_CLIENT_ID=
BUND_GIT_NAME=Bund
BUND_GIT_EMAIL=
